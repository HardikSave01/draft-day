  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">DraftDayCardFieldController – Arranges player cards in a wraparound 3D arc around the user</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float radiusCm = 165 {"hint":"Distance from the user to the card arc, in centimeters. Cards are uniformly scaled by radiusCm/110 so apparent (angular) size stays constant regardless of distance.", "widget":"slider", "min":100, "max":220, "step":5}'
    - '// @input float arcSpanDegrees = 100 {"hint":"Target horizontal angular span the card arc covers, in degrees (split evenly left/right of center). Widened automatically if columnGapDegrees would otherwise force card overlap.", "widget":"slider", "min":30, "max":160, "step":5}'
    - '// @input float columns = 8 {"hint":"Max card columns per row before wrapping to the next row", "widget":"slider", "min":1, "max":10, "step":1}'
    - "// @input float rowGapCm = 14 {\"hint\":\"Target vertical gap between card rows, in centimeters, before distance scaling. Enlarged automatically if it would otherwise be smaller than a scaled card's height plus a 2cm buffer.\", \"widget\":\"slider\", \"min\":8, \"max\":40, \"step\":1}"
    - "// @input float columnGapDegrees = 1.5 {\"hint\":\"Minimum angular gap between adjacent columns beyond each card's own angular width, in degrees — the floor arcSpanDegrees/columns is widened to respect\", \"widget\":\"slider\", \"min\":0, \"max\":20, \"step\":0.5}"
    - '// @ui {"widget":"group_end"}'

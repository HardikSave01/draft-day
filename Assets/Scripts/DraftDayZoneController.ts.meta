  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">DraftDayZoneController – Four 3D tier drop zones: hit testing, card custody, stack layout</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input AssignableType_1 zoneQB {\"hint\":\"Authored QB zone panel SceneObject's DraftDayZoneUI component\"}"
    - "// @input AssignableType_2 zoneRB {\"hint\":\"Authored RB zone panel SceneObject's DraftDayZoneUI component\"}"
    - "// @input AssignableType_3 zoneWR {\"hint\":\"Authored WR zone panel SceneObject's DraftDayZoneUI component\"}"
    - "// @input AssignableType_4 zoneTE {\"hint\":\"Authored TE zone panel SceneObject's DraftDayZoneUI component\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float dropPadXCm = 22 {"hint":"Horizontal slack around each zone panel that still counts as a drop, in centimeters. Generous by design — the card is routed by its own position, not by which zone was closest, so aim buys nothing. Capped at MAX_DROP_PAD_X_CM in code so the four acceptance boxes stay separate, with dead space between them.", "widget":"slider", "min":0, "max":40, "step":1}'
    - "// @input float dropPadYCm = 8 {\"hint\":\"Vertical slack around each zone panel that still counts as a drop, in centimeters. Keep well below the gap to the card arc above, or nudging an arc card downward would zone it by accident. Capped at MAX_DROP_PAD_Y_CM in code, derived from the card arc's lowest row — see the note at the top of the file.\", \"widget\":\"slider\", \"min\":0, \"max\":30, \"step\":1}"
    - '// @input float dropPadZCm = 70 {"hint":"Depth slack in front of and behind each zone panel that still counts as a drop, in centimeters. Large on purpose: judging depth in AR is the hardest part of the drop, so it should not have to be accurate.", "widget":"slider", "min":10, "max":120, "step":5}'
    - "// @input float stackCardScale = 0.8 {\"hint\":\"Scale applied to a card once it is sitting in a zone stack, relative to the zone panel. Capped at MAX_STACK_CARD_SCALE in code so a full fan fits the panel's stack band.\", \"widget\":\"slider\", \"min\":0.3, \"max\":1.2, \"step\":0.05}"
    - "// @input float stackOffsetYCm = 2.6 {\"hint\":\"Vertical drop between consecutive cards in a zone stack, in centimeters — how far the fan spreads. Capped at MAX_STACK_OFFSET_Y_CM in code so a full fan fits the panel's stack band.\", \"widget\":\"slider\", \"min\":1, \"max\":8, \"step\":0.1}"
    - '// @input float stackOffsetXCm = 0.6 {"hint":"Horizontal stagger between consecutive cards in a zone stack, in centimeters", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - "// @input float maxVisibleStack = 5 {\"hint\":\"How many cards a zone stack shows before the rest are hidden behind the header count. Also capped by how many actually fit the panel's stack band — see effectiveMaxVisible().\", \"widget\":\"slider\", \"min\":1, \"max\":10, \"step\":1}"
    - '// @ui {"widget":"group_end"}'
